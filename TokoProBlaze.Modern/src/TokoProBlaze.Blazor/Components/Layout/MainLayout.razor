@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="flex min-h-dvh flex-col bg-slate-100 text-slate-800">
    <div class="shrink-0">
        <MainRibbon />
    </div>

    <main class="relative z-0 mx-auto w-full max-w-[1600px] flex-1 px-3 py-4 sm:px-4 lg:px-6">
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
