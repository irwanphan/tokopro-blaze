@page "/master-barang"
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode(prerender: false))
@inject ProductApiClient ProductApiClient
@inject CustomerApiClient CustomerApiClient

<PageTitle>Master Barang</PageTitle>

<section class="space-y-4">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">Master Barang</h1>
            <p class="text-sm text-slate-600">Sprint 2 — daftar barang dari tabel legacy <span class="font-medium text-slate-800">tbbarang</span>. Kolom tambahan mengikuti form TokoPro; isi non-API tampil kosong sampai mapping dilakukan.</p>
        </div>
        @if (health is not null)
        {
            <span class="inline-flex w-fit rounded-full px-3 py-1 text-xs font-medium @(health.IsHealthy ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-700")">
                Data source: @health.Mode
            </span>
        }
        <div class="flex w-full flex-col gap-3 md:ml-auto md:max-w-xl md:flex-row md:items-end">
            <div class="min-w-0 flex-1">
                <label class="mb-1 block text-sm font-medium text-slate-700" for="keyword-barang">Cari barang</label>
                <input id="keyword-barang"
                       class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none"
                       value="@keyword"
                       @onchange="OnKeywordChanged"
                       placeholder="Kode, nama, atau satuan..." />
            </div>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Href="master-barang/input"
                       Class="shrink-0">
                + Input baru
            </MudButton>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700">@ErrorMessage</div>
    }
    else if (IsLoading)
    {
        <div class="rounded-lg border border-slate-200 bg-white p-6 text-center text-slate-500">Memuat data...</div>
    }
    else
    {
        <div class="grid gap-4 lg:grid-cols-3">
            <div class="overflow-hidden rounded-xl border border-slate-200 lg:col-span-2">
                <MudDataGrid @ref="_grid"
                             T="MasterBarangGridRow"
                             Items="@gridRows"
                             Dense="true"
                             Hover="true"
                             Striped="true"
                             Outlined="true"
                             Filterable="true"
                             ShowMenuIcon="true"
                             Hideable="true"
                             ColumnsPanelReordering="true"
                             FixedHeader="true"
                             Height="440px"
                             RowClick="@OnGridRowClick">
                    <ToolBarContent>
                        <MudText Typo="Typo.subtitle2" Class="mud-table-toolbar-title">Barang &amp; Jasa</MudText>
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.ViewColumn"
                                       Variant="Variant.Text"
                                       Color="Color.Default"
                                       title="Panel kolom: tampilkan, sembunyikan, urutkan"
                                       OnClick="OpenColumnsPanel" />
                    </ToolBarContent>
                    <Columns>
                        <PropertyColumn Property="x => x.No" Title="No" Hideable="true" />
                        <PropertyColumn Property="x => x.Kode" Title="Kode" Hideable="true" />
                        <PropertyColumn Property="x => x.Nama" Title="Nama" Hideable="true" />
                        <PropertyColumn Property="x => x.Satuan1" Title="Satuan 1" Hideable="true" />
                        <PropertyColumn Property="x => x.Satuan2" Title="Satuan 2" Hideable="true" />
                        <PropertyColumn Property="x => x.Satuan3" Title="Satuan 3" Hideable="true" />
                        <PropertyColumn Property="x => x.Barcode" Title="Barcode" Hideable="true" />
                        <PropertyColumn Property="x => x.Tipe" Title="Tipe" Hideable="true" />
                        <PropertyColumn Property="x => x.Divisi" Title="Divisi" Hideable="true" />
                        <PropertyColumn Property="x => x.Merk" Title="Merk" Hideable="true" />
                        <PropertyColumn Property="x => x.Grup" Title="Grup" Hideable="true" />
                        <PropertyColumn Property="x => x.Ukuran" Title="Ukuran" Hideable="true" />
                        <TemplateColumn Title="Status" Hideable="true">
                            <CellTemplate>
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Variant="Variant.Filled"
                                         Color="@(context.Item.Aktif ? Color.Success : Color.Default)"
                                         Text="@(context.Item.Aktif ? "Aktif" : "Nonaktif")" />
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Aksi" Hideable="false" Sortable="false" Filterable="false">
                            <CellTemplate>
                                <MudLink Href="@EditHref(context.Item.Kode)" Typo="Typo.body2">Edit</MudLink>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-4">
                <p class="text-sm font-semibold text-slate-700">Detail Barang</p>
                @if (selectedProduct is null)
                {
                    <p class="mt-2 text-sm text-slate-500">Pilih baris pada grid untuk melihat detail.</p>
                }
                else
                {
                    <dl class="mt-3 space-y-2 text-sm">
                        <div>
                            <dt class="text-slate-500">Kode</dt>
                            <dd class="font-medium text-slate-800">@selectedProduct.Code</dd>
                        </div>
                        <div>
                            <dt class="text-slate-500">Nama</dt>
                            <dd class="font-medium text-slate-800">@selectedProduct.Name</dd>
                        </div>
                        <div>
                            <dt class="text-slate-500">Satuan 1</dt>
                            <dd class="font-medium text-slate-800">@selectedProduct.Unit1</dd>
                        </div>
                        <div>
                            <dt class="text-slate-500">Status</dt>
                            <dd class="font-medium @(selectedProduct.IsActive ? "text-emerald-700" : "text-slate-600")">
                                @(selectedProduct.IsActive ? "Aktif" : "Nonaktif")
                            </dd>
                        </div>
                        <div class="pt-2">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Href="@EditHref(selectedProduct.Code)">
                                Buka form edit
                            </MudButton>
                        </div>
                    </dl>
                }
            </div>
        </div>
        <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm">
            <p class="text-slate-600">Halaman @currentPage dari @totalPages - Total @totalItems data</p>
            <div class="flex gap-2">
                <MudButton Variant="Variant.Outlined"
                           Disabled="@(currentPage <= 1)"
                           OnClick="PreviousPageAsync">
                    Sebelumnya
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Disabled="@(currentPage >= totalPages)"
                           OnClick="NextPageAsync">
                    Berikutnya
                </MudButton>
            </div>
        </div>
    }
</section>

@code {
    private MudDataGrid<MasterBarangGridRow>? _grid;
    private IReadOnlyList<ProductVm> products = [];
    private IReadOnlyList<MasterBarangGridRow> gridRows = [];
    private ProductVm? selectedProduct;
    private LegacyDbHealthVm? health;
    private string? keyword;
    private bool isLoading = true;
    private string? errorMessage;
    private int currentPage = 1;
    private const int PageSize = 20;
    private int totalPages = 1;
    private int totalItems;

    private bool IsLoading => isLoading;
    private string? ErrorMessage => errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            health = await CustomerApiClient.GetLegacyDbHealthAsync();
        }
        catch (Exception)
        {
            health = new LegacyDbHealthVm(false, "fallback", "Tidak dapat menghubungi API (pastikan TokoProBlaze.Api berjalan dan ApiBaseUrl benar).");
        }

        await LoadProductsAsync();
    }

    private async Task OnKeywordChanged(ChangeEventArgs e)
    {
        keyword = e.Value?.ToString();
        currentPage = 1;
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var response = await ProductApiClient.GetProductsPageAsync(currentPage, PageSize, keyword);
            currentPage = response.Page;
            totalPages = response.TotalPages;
            totalItems = response.TotalItems;
            products = response.Items;
            RebuildGridRows();
            selectedProduct = null;
        }
        catch (Exception)
        {
            errorMessage = "Gagal mengambil data barang dari API wrapper.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void RebuildGridRows()
    {
        var start = (currentPage - 1) * PageSize;
        gridRows = products
            .Select((p, i) => MasterBarangGridRow.FromProduct(p, start + i + 1))
            .ToList();
    }

    private async Task OnGridRowClick(DataGridRowClickEventArgs<MasterBarangGridRow> args)
    {
        if (args.Item is null)
        {
            return;
        }

        await LoadProductDetailAsync(args.Item.Kode);
    }

    private void OpenColumnsPanel(MouseEventArgs e) => _grid?.ShowColumnsPanel(e);

    private async Task LoadProductDetailAsync(string code)
    {
        selectedProduct = await ProductApiClient.GetProductByCodeAsync(code);
    }

    private static string EditHref(string code) =>
        $"master-barang/input?code={Uri.EscapeDataString(code)}";

    private async Task PreviousPageAsync()
    {
        if (currentPage <= 1)
        {
            return;
        }

        currentPage--;
        await LoadProductsAsync();
    }

    private async Task NextPageAsync()
    {
        if (currentPage >= totalPages)
        {
            return;
        }

        currentPage++;
        await LoadProductsAsync();
    }
}
