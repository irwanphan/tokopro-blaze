@inherits LayoutComponentBase

<div class="min-h-screen bg-slate-50 text-slate-800">
    <div class="mx-auto flex max-w-7xl gap-4 px-4 py-4 lg:px-6">
        <aside class="w-72 shrink-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <NavMenu />
        </aside>

        <main class="flex-1 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
