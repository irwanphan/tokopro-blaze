@page "/master-barang"
@inject ProductApiClient ProductApiClient
@inject CustomerApiClient CustomerApiClient

<PageTitle>Master Barang</PageTitle>

<section class="space-y-4">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">Master Barang</h1>
            <p class="text-sm text-slate-600">Sprint 2 — daftar barang dari tabel legacy <span class="font-medium text-slate-800">tbbarang</span>.</p>
        </div>
        @if (health is not null)
        {
            <span class="inline-flex w-fit rounded-full px-3 py-1 text-xs font-medium @(health.IsHealthy ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-700")">
                Data source: @health.Mode
            </span>
        }
        <div class="flex w-full flex-col gap-3 md:ml-auto md:max-w-xl md:flex-row md:items-end">
            <div class="min-w-0 flex-1">
                <label class="mb-1 block text-sm font-medium text-slate-700" for="keyword-barang">Cari barang</label>
                <input id="keyword-barang"
                       class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none"
                       @bind="Keyword"
                       @bind:event="onchange"
                       placeholder="Kode, nama, atau satuan..." />
            </div>
            <NavLink href="master-barang/input"
                     class="inline-flex shrink-0 items-center justify-center rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-sky-700">
                + Input baru
            </NavLink>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700">@ErrorMessage</div>
    }
    else if (IsLoading)
    {
        <div class="rounded-lg border border-slate-200 bg-white p-6 text-center text-slate-500">Memuat data...</div>
    }
    else
    {
        <div class="grid gap-4 lg:grid-cols-3">
            <div class="overflow-hidden rounded-xl border border-slate-200 lg:col-span-2">
                <table class="min-w-full divide-y divide-slate-200 text-sm">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-4 py-3 text-left font-semibold text-slate-600">Kode</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-600">Nama</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-600">Satuan</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-600">Status</th>
                            <th class="px-4 py-3 text-right font-semibold text-slate-600">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 bg-white">
                        @foreach (var product in products)
                        {
                            <tr class="cursor-pointer hover:bg-slate-50" @onclick="() => LoadProductDetailAsync(product.Code)">
                                <td class="px-4 py-3 font-medium text-slate-800">@product.Code</td>
                                <td class="px-4 py-3 text-slate-700">@product.Name</td>
                                <td class="px-4 py-3 text-slate-700">@product.Unit1</td>
                                <td class="px-4 py-3">
                                    <span class="rounded-full px-2 py-1 text-xs font-medium @(product.IsActive ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-600")">
                                        @(product.IsActive ? "Aktif" : "Nonaktif")
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-right" @onclick:stopPropagation="true">
                                    <NavLink href="@EditHref(product.Code)"
                                             class="text-sm font-medium text-sky-700 hover:text-sky-900 hover:underline">
                                        Edit
                                    </NavLink>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-4">
                <p class="text-sm font-semibold text-slate-700">Detail Barang</p>
                @if (selectedProduct is null)
                {
                    <p class="mt-2 text-sm text-slate-500">Pilih barang dari tabel untuk melihat detail.</p>
                }
                else
                {
                    <dl class="mt-3 space-y-2 text-sm">
                        <div>
                            <dt class="text-slate-500">Kode</dt>
                            <dd class="font-medium text-slate-800">@selectedProduct.Code</dd>
                        </div>
                        <div>
                            <dt class="text-slate-500">Nama</dt>
                            <dd class="font-medium text-slate-800">@selectedProduct.Name</dd>
                        </div>
                        <div>
                            <dt class="text-slate-500">Satuan 1</dt>
                            <dd class="font-medium text-slate-800">@selectedProduct.Unit1</dd>
                        </div>
                        <div>
                            <dt class="text-slate-500">Status</dt>
                            <dd class="font-medium @(selectedProduct.IsActive ? "text-emerald-700" : "text-slate-600")">
                                @(selectedProduct.IsActive ? "Aktif" : "Nonaktif")
                            </dd>
                        </div>
                        <div class="pt-2">
                            <NavLink href="@EditHref(selectedProduct.Code)"
                                     class="inline-flex rounded-lg border border-sky-200 bg-sky-50 px-3 py-1.5 text-sm font-medium text-sky-800 hover:bg-sky-100">
                                Buka form edit
                            </NavLink>
                        </div>
                    </dl>
                }
            </div>
        </div>
        <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm">
            <p class="text-slate-600">Halaman @currentPage dari @totalPages - Total @totalItems data</p>
            <div class="flex gap-2">
                <button class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-700 disabled:cursor-not-allowed disabled:opacity-50"
                        disabled="@(currentPage <= 1)"
                        @onclick="PreviousPageAsync">
                    Sebelumnya
                </button>
                <button class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-700 disabled:cursor-not-allowed disabled:opacity-50"
                        disabled="@(currentPage >= totalPages)"
                        @onclick="NextPageAsync">
                    Berikutnya
                </button>
            </div>
        </div>
    }
</section>

@code {
    private IReadOnlyList<ProductVm> products = [];
    private ProductVm? selectedProduct;
    private LegacyDbHealthVm? health;
    private string? keyword;
    private bool isLoading = true;
    private string? errorMessage;
    private int currentPage = 1;
    private const int PageSize = 20;
    private int totalPages = 1;
    private int totalItems;

    private string? Keyword
    {
        get => keyword;
        set
        {
            keyword = value;
            currentPage = 1;
            _ = LoadProductsAsync();
        }
    }

    private bool IsLoading => isLoading;
    private string? ErrorMessage => errorMessage;

    protected override async Task OnInitializedAsync()
    {
        health = await CustomerApiClient.GetLegacyDbHealthAsync();
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var response = await ProductApiClient.GetProductsPageAsync(currentPage, PageSize, keyword);
            currentPage = response.Page;
            totalPages = response.TotalPages;
            totalItems = response.TotalItems;
            products = response.Items;
            selectedProduct = null;
        }
        catch (Exception)
        {
            errorMessage = "Gagal mengambil data barang dari API wrapper.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadProductDetailAsync(string code)
    {
        selectedProduct = await ProductApiClient.GetProductByCodeAsync(code);
    }

    private static string EditHref(string code) =>
        $"master-barang/input?code={Uri.EscapeDataString(code)}";

    private async Task PreviousPageAsync()
    {
        if (currentPage <= 1)
        {
            return;
        }

        currentPage--;
        await LoadProductsAsync();
    }

    private async Task NextPageAsync()
    {
        if (currentPage >= totalPages)
        {
            return;
        }

        currentPage++;
        await LoadProductsAsync();
    }
}
