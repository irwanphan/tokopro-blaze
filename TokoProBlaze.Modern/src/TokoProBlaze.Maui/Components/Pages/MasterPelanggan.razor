@page "/master-pelanggan"
@inject ICustomerDirectoryReader CustomerDirectory

<PageTitle>Master Pelanggan</PageTitle>

<section class="tp-stack">
    <div class="d-flex flex-column flex-md-row gap-3 align-items-md-end justify-content-md-between">
        <div>
            <h1 class="h3 fw-semibold text-dark mb-1">Master Pelanggan</h1>
            <p class="text-muted small mb-0">Modul hybrid memanggil API wrapper legacy (bukan akses DB langsung).</p>
        </div>
        @if (health is not null)
        {
            <span class="badge rounded-pill @(health.IsHealthy ? "text-bg-success-subtle text-success-emphasis" : "text-bg-warning-subtle text-warning-emphasis")">
                Data source: @health.Mode
            </span>
        }
        <div class="w-100" style="max-width: 22rem;">
            <label class="form-label small fw-medium text-secondary" for="keyword">Cari pelanggan</label>
            <input id="keyword"
                   class="form-control form-control-sm"
                   @bind="Keyword"
                   @bind:event="onchange"
                   placeholder="Kode, nama, atau kota..." />
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger small mb-0" role="alert">@ErrorMessage</div>
    }
    else if (IsLoading)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center text-muted py-5">Memuat data...</div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-secondary small text-uppercase">Kode</th>
                                    <th class="text-secondary small text-uppercase">Nama</th>
                                    <th class="text-secondary small text-uppercase">Kota</th>
                                    <th class="text-secondary small text-uppercase">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var customer in customers)
                                {
                                    <tr class="tp-row-select" @onclick="() => LoadCustomerDetailAsync(customer.Code)">
                                        <td class="fw-medium">@customer.Code</td>
                                        <td>@customer.Name</td>
                                        <td>@customer.City</td>
                                        <td>
                                            <span class="badge rounded-pill @(customer.IsActive ? "text-bg-success-subtle text-success-emphasis" : "text-bg-secondary-subtle text-secondary-emphasis")">
                                                @(customer.IsActive ? "Aktif" : "Nonaktif")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="small fw-semibold text-secondary mb-2">Detail Pelanggan</p>
                        @if (selectedCustomer is null)
                        {
                            <p class="text-muted small mb-0">Pilih pelanggan dari tabel untuk melihat detail.</p>
                        }
                        else
                        {
                            <dl class="row small mb-0">
                                <dt class="col-4 text-muted">Kode</dt>
                                <dd class="col-8 fw-medium mb-2">@selectedCustomer.Code</dd>
                                <dt class="col-4 text-muted">Nama</dt>
                                <dd class="col-8 fw-medium mb-2">@selectedCustomer.Name</dd>
                                <dt class="col-4 text-muted">Kota</dt>
                                <dd class="col-8 fw-medium mb-2">@selectedCustomer.City</dd>
                                <dt class="col-4 text-muted">Status</dt>
                                <dd class="col-8 fw-medium mb-0 @(selectedCustomer.IsActive ? "text-success" : "text-secondary")">
                                    @(selectedCustomer.IsActive ? "Aktif" : "Nonaktif")
                                </dd>
                            </dl>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 py-3">
                <p class="text-muted small mb-0">Halaman @currentPage dari @totalPages — Total @totalItems data</p>
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary" disabled="@(currentPage <= 1)" @onclick="PreviousPageAsync">Sebelumnya</button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@(currentPage >= totalPages)" @onclick="NextPageAsync">Berikutnya</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private IReadOnlyList<CustomerRow> customers = [];
    private CustomerRow? selectedCustomer;
    private LegacyDbHealth? health;
    private string? keyword;
    private bool isLoading = true;
    private string? errorMessage;
    private int currentPage = 1;
    private const int PageSize = 20;
    private int totalPages = 1;
    private int totalItems;

    private string? Keyword
    {
        get => keyword;
        set
        {
            keyword = value;
            currentPage = 1;
            _ = LoadCustomersAsync();
        }
    }

    private bool IsLoading => isLoading;
    private string? ErrorMessage => errorMessage;

    protected override async Task OnInitializedAsync()
    {
        health = await CustomerDirectory.GetLegacyDbHealthAsync();
        await LoadCustomersAsync();
    }

    private async Task LoadCustomersAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var response = await CustomerDirectory.GetCustomersPageAsync(currentPage, PageSize, keyword);
            currentPage = response.Page;
            totalPages = response.TotalPages;
            totalItems = response.TotalItems;
            customers = response.Items;
            selectedCustomer = null;
        }
        catch (Exception)
        {
            errorMessage = "Gagal mengambil data pelanggan dari API wrapper.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCustomerDetailAsync(string code)
    {
        selectedCustomer = await CustomerDirectory.GetCustomerByCodeAsync(code);
    }

    private async Task PreviousPageAsync()
    {
        if (currentPage <= 1)
        {
            return;
        }

        currentPage--;
        await LoadCustomersAsync();
    }

    private async Task NextPageAsync()
    {
        if (currentPage >= totalPages)
        {
            return;
        }

        currentPage++;
        await LoadCustomersAsync();
    }
}
