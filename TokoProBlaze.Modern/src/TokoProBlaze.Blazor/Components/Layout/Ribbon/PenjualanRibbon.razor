<div class="flex flex-wrap items-stretch gap-y-2">
    <RibbonGroup Title="Pelanggan">
        <div class="flex flex-wrap gap-3">
            <div class="flex flex-col gap-0.5">
                <RibbonMiniLink Text="Tipe Pelanggan" Icon="@RibbonIcons.Users" />
                <RibbonMiniLink Text="Area Pelanggan" Icon="@RibbonIcons.Map" />
                <RibbonMiniLink Text="Rute Pelanggan" Icon="@RibbonIcons.Route" />
            </div>
            <div class="flex flex-col gap-0.5">
                <RibbonMiniLink Text="Pelanggan" Href="master-pelanggan" Icon="@RibbonIcons.UserCard" />
                <RibbonMiniLink Text="Salesman" Icon="@RibbonIcons.Briefcase" />
            </div>
        </div>
    </RibbonGroup>
    <RibbonGroup Title="Penjualan">
        <div class="flex flex-wrap gap-2">
            <RibbonTileLink Text="Pesanan Penjualan" Icon="@RibbonIcons.Clipboard" />
            <RibbonTileLink Text="Faktur Penjualan" Icon="@RibbonIcons.Invoice" />
            <RibbonTileLink Text="Pengiriman Barang" Icon="@RibbonIcons.Truck" />
            <RibbonTileLink Text="Retur" Icon="@RibbonIcons.Undo" />
            <RibbonTileLink Text="Promo" Icon="@RibbonIcons.Spark" />
            <RibbonTileLink Text="Sampel" Icon="@RibbonIcons.Package" />
            <RibbonTileLink Text="Surat Jalan" Icon="@RibbonIcons.Doc" />
        </div>
    </RibbonGroup>
    <RibbonGroup Title="Penagihan">
        <div class="flex flex-wrap gap-2">
            <RibbonTileLink Text="Kolektor" Icon="@RibbonIcons.UserCard" />
            <RibbonTileLink Text="Daftar Penagihan" Icon="@RibbonIcons.List" />
        </div>
    </RibbonGroup>
</div>
