@page "/master-pelanggan"
@inject CustomerApiClient CustomerApiClient

<PageTitle>Master Pelanggan</PageTitle>

<section class="space-y-4">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">Master Pelanggan</h1>
            <p class="text-sm text-slate-600">Contoh modul Sprint 1 yang consume API wrapper legacy.</p>
        </div>
        @if (health is not null)
        {
            <span class="inline-flex w-fit rounded-full px-3 py-1 text-xs font-medium @(health.IsHealthy ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-700")">
                Data source: @health.Mode
            </span>
        }
        <div class="w-full md:w-80">
            <label class="mb-1 block text-sm font-medium text-slate-700" for="keyword">Cari pelanggan</label>
            <input id="keyword"
                   class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none"
                   @bind="Keyword"
                   @bind:event="onchange"
                   placeholder="Kode, nama, atau kota..." />
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700">@ErrorMessage</div>
    }
    else if (IsLoading)
    {
        <div class="rounded-lg border border-slate-200 bg-white p-6 text-center text-slate-500">Memuat data...</div>
    }
    else
    {
        <div class="grid gap-4 lg:grid-cols-3">
            <div class="overflow-hidden rounded-xl border border-slate-200 lg:col-span-2">
                <table class="min-w-full divide-y divide-slate-200 text-sm">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-4 py-3 text-left font-semibold text-slate-600">Kode</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-600">Nama</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-600">Kota</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-600">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 bg-white">
                        @foreach (var customer in customers)
                        {
                            <tr class="cursor-pointer hover:bg-slate-50" @onclick="() => LoadCustomerDetailAsync(customer.Code)">
                                <td class="px-4 py-3 font-medium text-slate-800">@customer.Code</td>
                                <td class="px-4 py-3 text-slate-700">@customer.Name</td>
                                <td class="px-4 py-3 text-slate-700">@customer.City</td>
                                <td class="px-4 py-3">
                                    <span class="rounded-full px-2 py-1 text-xs font-medium @(customer.IsActive ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-600")">
                                        @(customer.IsActive ? "Aktif" : "Nonaktif")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-4">
                <p class="text-sm font-semibold text-slate-700">Detail Pelanggan</p>
                @if (selectedCustomer is null)
                {
                    <p class="mt-2 text-sm text-slate-500">Pilih pelanggan dari tabel untuk melihat detail.</p>
                }
                else
                {
                    <dl class="mt-3 space-y-2 text-sm">
                        <div>
                            <dt class="text-slate-500">Kode</dt>
                            <dd class="font-medium text-slate-800">@selectedCustomer.Code</dd>
                        </div>
                        <div>
                            <dt class="text-slate-500">Nama</dt>
                            <dd class="font-medium text-slate-800">@selectedCustomer.Name</dd>
                        </div>
                        <div>
                            <dt class="text-slate-500">Kota</dt>
                            <dd class="font-medium text-slate-800">@selectedCustomer.City</dd>
                        </div>
                        <div>
                            <dt class="text-slate-500">Status</dt>
                            <dd class="font-medium @(selectedCustomer.IsActive ? "text-emerald-700" : "text-slate-600")">
                                @(selectedCustomer.IsActive ? "Aktif" : "Nonaktif")
                            </dd>
                        </div>
                    </dl>
                }
            </div>
        </div>
        <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm">
            <p class="text-slate-600">Halaman @currentPage dari @totalPages - Total @totalItems data</p>
            <div class="flex gap-2">
                <button class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-700 disabled:cursor-not-allowed disabled:opacity-50"
                        disabled="@(currentPage <= 1)"
                        @onclick="PreviousPageAsync">
                    Sebelumnya
                </button>
                <button class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-700 disabled:cursor-not-allowed disabled:opacity-50"
                        disabled="@(currentPage >= totalPages)"
                        @onclick="NextPageAsync">
                    Berikutnya
                </button>
            </div>
        </div>
    }
</section>

@code {
    private IReadOnlyList<CustomerVm> customers = [];
    private CustomerVm? selectedCustomer;
    private LegacyDbHealthVm? health;
    private string? keyword;
    private bool isLoading = true;
    private string? errorMessage;
    private int currentPage = 1;
    private const int PageSize = 20;
    private int totalPages = 1;
    private int totalItems;

    private string? Keyword
    {
        get => keyword;
        set
        {
            keyword = value;
            currentPage = 1;
            _ = LoadCustomersAsync();
        }
    }

    private bool IsLoading => isLoading;
    private string? ErrorMessage => errorMessage;

    protected override async Task OnInitializedAsync()
    {
        health = await CustomerApiClient.GetLegacyDbHealthAsync();
        await LoadCustomersAsync();
    }

    private async Task LoadCustomersAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var response = await CustomerApiClient.GetCustomersPageAsync(currentPage, PageSize, keyword);
            currentPage = response.Page;
            totalPages = response.TotalPages;
            totalItems = response.TotalItems;
            customers = response.Items;
            selectedCustomer = null;
        }
        catch (Exception)
        {
            errorMessage = "Gagal mengambil data pelanggan dari API wrapper.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCustomerDetailAsync(string code)
    {
        selectedCustomer = await CustomerApiClient.GetCustomerByCodeAsync(code);
    }

    private async Task PreviousPageAsync()
    {
        if (currentPage <= 1)
        {
            return;
        }

        currentPage--;
        await LoadCustomersAsync();
    }

    private async Task NextPageAsync()
    {
        if (currentPage >= totalPages)
        {
            return;
        }

        currentPage++;
        await LoadCustomersAsync();
    }
}
